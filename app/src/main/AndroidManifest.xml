<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalorieTrackingApp">

        <!-- Giriş noktası: profil kontrolü yapılır -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CalorieTrackingApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Giriş ekranı -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Kayıt ekranı -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- İlk kurulum: kullanıcı profili oluşturma -->
        <activity
            android:name=".activities.ProfileSetupActivity"
            android:exported="false" />

        <!-- Ana ekran: günlük kalori dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Yemek ekleme ekranı -->
        <activity
            android:name=".activities.AddMealActivity"
            android:exported="false" />

        <!-- Gıda arama ve listeleme -->
        <activity
            android:name=".activities.FoodSearchActivity"
            android:exported="false" />

        <!-- Haftalık rapor ekranı -->
        <activity
            android:name=".activities.WeeklyReportActivity"
            android:exported="false" />

        <!-- Profil düzenleme -->
        <activity
            android:name=".activities.ProfileEditActivity"
            android:exported="false" />

        <!-- Kamera ile yemek tanıma (mock) -->
        <activity
            android:name=".activities.CameraActivity"
            android:exported="false" />

        <!-- Ayarlar: profil, dil, tema -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <!-- Profil sayfası -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />

        <!-- FileProvider: kamera fotoğrafı için güvenli URI -->  
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
